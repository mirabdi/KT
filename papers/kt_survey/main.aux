\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Cognitive and Psychometric Interpretability Deconstructed.} (a) Monotonic attention heads specialize into distinct cognitive timescales: working memory ($\theta _1 = 1.115$), intermediate review ($\theta _4 = 0.646$), and long-term retention ($\theta _7 = 0.386$). (b) Learned Rasch item difficulties ($\mu _q$) exhibit strong construct validity, correlating positively with empirical student failure rates ($r = +0.778$, $p < 10^{-15}$, or $r = -0.778$ with student pass rate). (c) Memory slot collision ratio ($C / N_m$): when concepts outnumber slots ($C \gg N_m$), memory networks degrade substantially on \textsc  {Statics2011}.}}{12}{figure.caption.17}\protected@file@percent }
\newlabel{fig:interpretability_deconstructed}{{5}{12}{\textbf {Cognitive and Psychometric Interpretability Deconstructed.} (a) Monotonic attention heads specialize into distinct cognitive timescales: working memory ($\theta _1 = 1.115$), intermediate review ($\theta _4 = 0.646$), and long-term retention ($\theta _7 = 0.386$). (b) Learned Rasch item difficulties ($\mu _q$) exhibit strong construct validity, correlating positively with empirical student failure rates ($r = +0.778$, $p < 10^{-15}$, or $r = -0.778$ with student pass rate). (c) Memory slot collision ratio ($C / N_m$): when concepts outnumber slots ($C \gg N_m$), memory networks degrade substantially on \textsc {Statics2011}}{figure.caption.17}{}}
