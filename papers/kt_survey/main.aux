\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The Systems Deployment Frontier.} (a) Test AUC vs. single-step next-item inference latency ($L=200$). Production Intelligent Tutoring Systems enforce a $\le 10$ ms latency SLA (red dashed ceiling). Memory networks (\textsc  {DKVMN}) exceed this threshold due to sequential write-erase loops, while \textsc  {simpleKT}, \textsc  {SAKT}, and \textsc  {DKT} execute in under 1.5 ms. (b) Parameter scaling on \textsc  {Algebra2005} (173k items): Rasch shrinkage reduces parameters by 97.5\% while improving test AUC by +4.48\%.}}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:pareto_tradeoff}{{4}{11}{\textbf {The Systems Deployment Frontier.} (a) Test AUC vs. single-step next-item inference latency ($L=200$). Production Intelligent Tutoring Systems enforce a $\le 10$ ms latency SLA (red dashed ceiling). Memory networks (\textsc {DKVMN}) exceed this threshold due to sequential write-erase loops, while \textsc {simpleKT}, \textsc {SAKT}, and \textsc {DKT} execute in under 1.5 ms. (b) Parameter scaling on \textsc {Algebra2005} (173k items): Rasch shrinkage reduces parameters by 97.5\% while improving test AUC by +4.48\%}{figure.caption.14}{}}
