\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Our Proposed SynapseKT Dual-Process Architecture.} Student interactions are embedded via 2PL-Rasch psychometric projections. Stream A (Working Memory) processes local streaks via causal 1D convolutions and GLUs. Stream B (Long-Term Associative Memory) retrieves curriculum mastery via context-aware monotonic attention with Ebbinghaus consolidation decay. A confidence gate dynamically fuses both streams into a final psychometric prediction logit.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:synapsekt_arch}{{2}{6}{\textbf {Our Proposed SynapseKT Dual-Process Architecture.} Student interactions are embedded via 2PL-Rasch psychometric projections. Stream A (Working Memory) processes local streaks via causal 1D convolutions and GLUs. Stream B (Long-Term Associative Memory) retrieves curriculum mastery via context-aware monotonic attention with Ebbinghaus consolidation decay. A confidence gate dynamically fuses both streams into a final psychometric prediction logit}{figure.caption.4}{}}
