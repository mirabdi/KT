\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Master Cross-Dataset Empirical Benchmark.} 5-fold student-level cross-validation performance across 6 canonical educational datasets (390 experimental runs). All 20 model configurations are evaluated across 7 paradigm families. Bold indicates top performance per dataset; underline indicates runner-up. Dashes ($-$) indicate concept-only datasets lacking item-level question IDs where Rasch variants reduce to non-Rasch. Datasets span four distinct educational regimes: Longitudinal Tutoring (\textsc  {ASSIST09}, \textsc  {ASSIST17}), Ultra-Sparse Catalogs (\textsc  {Algebra05}), Granular Concepts (\textsc  {Statics11}), and Dense Diagnostic Quizzes (\textsc  {NIPS34}, \textsc  {ASSIST15}).}}{9}{table.caption.12}\protected@file@percent }
\newlabel{tab:master_benchmark}{{1}{9}{\textbf {Master Cross-Dataset Empirical Benchmark.} 5-fold student-level cross-validation performance across 6 canonical educational datasets (390 experimental runs). All 20 model configurations are evaluated across 7 paradigm families. Bold indicates top performance per dataset; underline indicates runner-up. Dashes ($-$) indicate concept-only datasets lacking item-level question IDs where Rasch variants reduce to non-Rasch. Datasets span four distinct educational regimes: Longitudinal Tutoring (\textsc {ASSIST09}, \textsc {ASSIST17}), Ultra-Sparse Catalogs (\textsc {Algebra05}), Granular Concepts (\textsc {Statics11}), and Dense Diagnostic Quizzes (\textsc {NIPS34}, \textsc {ASSIST15})}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Cross-Regime Generalization Radar Profiles.} Normalized performance profiles across four educational regimes: Longitudinal Practice (ASSISTments2009), Sparse Catalogs (Algebra2005), Granular Hierarchies (Statics2011), and Dense Diagnostics (NIPS34). Illustrates the cross-regime stability of our proposed \textsc  {SynapseKT} architecture and Rasch-regularized models.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cross_radar}{{3}{9}{\textbf {Cross-Regime Generalization Radar Profiles.} Normalized performance profiles across four educational regimes: Longitudinal Practice (ASSISTments2009), Sparse Catalogs (Algebra2005), Granular Hierarchies (Statics2011), and Dense Diagnostics (NIPS34). Illustrates the cross-regime stability of our proposed \textsc {SynapseKT} architecture and Rasch-regularized models}{figure.caption.13}{}}
