\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Systematic Candidate Exploration \& Architectural Ablation Matrix.} To screen 15 architectural variants without confounding post-hoc Rasch calibration, accuracy metrics (Test AUC, RMSE, ACC) are evaluated using uncalibrated 5-epoch end-to-end training on the controlled 42.8k-interaction Rasch screening split (seed 42), whereas Table~\ref {tab:main_benchmark} reports full 20-epoch 5-fold cross-validation with post-epoch Fisher Rasch calibration (0.8384 AUC on \textsc  {ASSISTments2009}). Hardware Peak Memory and Epoch Time are profiled on the full \textsc  {ASSISTments2009} dataset (325k interactions) on Apple Silicon M3 MPS.}}{7}{table.caption.15}\protected@file@percent }
\newlabel{tab:ablation}{{2}{7}{\textbf {Systematic Candidate Exploration \& Architectural Ablation Matrix.} To screen 15 architectural variants without confounding post-hoc Rasch calibration, accuracy metrics (Test AUC, RMSE, ACC) are evaluated using uncalibrated 5-epoch end-to-end training on the controlled 42.8k-interaction Rasch screening split (seed 42), whereas Table~\ref {tab:main_benchmark} reports full 20-epoch 5-fold cross-validation with post-epoch Fisher Rasch calibration (0.8384 AUC on \textsc {ASSISTments2009}). Hardware Peak Memory and Epoch Time are profiled on the full \textsc {ASSISTments2009} dataset (325k interactions) on Apple Silicon M3 MPS}{table.caption.15}{}}
