\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The SynapseKT Dual-Process Architecture.} Chronological student interactions are embedded via parameter-efficient 2PL-Rasch psychometric projections. Interactions are partitioned into two concurrent processing streams: \textbf  {Stream A (Working Memory)} captures local momentum, fatigue, and streaks via multi-scale causal 1D depthwise convolutions and Gated Linear Units (GLUs); \textbf  {Stream B (Long-Term Associative Memory)} retrieves curriculum mastery via context-aware monotonic multi-head attention with adaptive Ebbinghaus consolidation decay. A learned psychometric confidence gate dynamically fuses both streams into a unified state, which is scaled by item discrimination $\alpha _q$ in the prediction head.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:synapsekt_arch}{{1}{2}{\textbf {The SynapseKT Dual-Process Architecture.} Chronological student interactions are embedded via parameter-efficient 2PL-Rasch psychometric projections. Interactions are partitioned into two concurrent processing streams: \textbf {Stream A (Working Memory)} captures local momentum, fatigue, and streaks via multi-scale causal 1D depthwise convolutions and Gated Linear Units (GLUs); \textbf {Stream B (Long-Term Associative Memory)} retrieves curriculum mastery via context-aware monotonic multi-head attention with adaptive Ebbinghaus consolidation decay. A learned psychometric confidence gate dynamically fuses both streams into a unified state, which is scaled by item discrimination $\alpha _q$ in the prediction head}{figure.caption.1}{}}
